{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM Gateway",
      "options": {
        "baseURL": "YOUR_URL_HERE",
        "apiKey": "YOUR_API_KEY_HERE"
      },
      "models": {
        "kimi-k2.6": {
          "name": "kimi-k2.6"
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro"
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        },
        "claude-sonnet-4-6": {
          "name": "claude-sonnet-4-6"
        },
        "glm-5.2": {
          "name": "glm-5.2"
        },
        "glm-5.3": {
          "name": "glm-5.3"
        }
      }
    }
  },
  "model": "glm-5.3",
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl",
        "http://127.0.0.1:9222"
      ]
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "oauth": false
    }
  },
  "tools": {
    "chrome-devtools_*": true,
    "chrome-devtools_lighthouse_audit": false,
    "chrome-devtools_performance_analyze_insight": false,
    "chrome-devtools_performance_start_trace": false,
    "chrome-devtools_performance_stop_trace": false,
    "chrome-devtools_take_memory_snapshot": false,
    "chrome-devtools_emulate": false
  },
  "formatter": true,
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "git stash show*": "allow",
      "git rev-parse*": "allow",
      "git rev-list*": "allow",
      "git ls-tree*": "allow",
      "git ls-files*": "allow",
      "git describe*": "allow",
      "cat*": "allow",
      "grep*": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "which*": "allow",
      "date": "allow",
      "whoami": "allow",
      "uname*": "allow",
      "bun run*": "allow",
      "php artisan test*": "allow",
      "ruff*": "allow",
      "docker exec -i ff_app*": "allow",
      "systemctl *": "ask",
      "vendor/bin/pint*": "allow",
      "sudo *": "ask"
    },
    "lsp": "allow",
    "edit": {
      "*": "allow"
    }
  },
  "plugin": [
    "@warp-dot-dev/opencode-warp",
    "@cortexkit/opencode-magic-context@latest",
    "@slkiser/opencode-quota",
    "@dietrichgebert/ponytail"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "agent": {
    "general": {
      "mode": "subagent",
      "model": "litellm/deepseek-v4-pro",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow",
          "git show*": "allow",
          "git stash show*": "allow",
          "git rev-parse*": "allow",
          "git rev-list*": "allow",
          "git ls-tree*": "allow",
          "git ls-files*": "allow",
          "git describe*": "allow",
          "cat*": "allow",
          "grep*": "allow",
          "ls*": "allow",
          "pwd": "allow",
          "which*": "allow",
          "date": "allow",
          "whoami": "allow",
          "uname*": "allow",
          "bun run*": "allow",
          "php artisan test*": "allow",
          "ruff*": "allow",
          "docker exec -i ff_app*": "allow",
          "systemctl *": "ask",
          "vendor/bin/pint*": "allow",
          "sudo *": "ask"
        },
        "task": "allow",
        "todowrite": "allow",
        "question": "allow",
        "skill": "allow",
        "doom_loop": "allow",
        "external_directory": "allow"
      }
    },
    "explore": {
      "mode": "subagent",
      "model": "litellm/deepseek-v4-flash",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "external_directory": "allow",
        "doom_loop": "allow",
        "bash": {
          "*": "deny",
          "cat*": "allow",
          "grep*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow",
          "git show*": "allow",
          "git stash show*": "allow",
          "git rev-parse*": "allow",
          "git rev-list*": "allow",
          "git ls-tree*": "allow",
          "git ls-files*": "allow",
          "git describe*": "allow"
        }
      }
    },
    "scout": {
      "description": "Read-only research subagent that prefers DeepWiki, then Context7, then web fallback",
      "mode": "subagent",
      "model": "litellm/deepseek-v4-flash",
      "prompt": "{file:./agents/scout.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "external_directory": "allow",
        "doom_loop": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "context7_*": "allow",
        "deepwiki_*": "allow",
        "bash": {
          "*": "deny",
          "cat*": "allow",
          "grep*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow",
          "git show*": "allow",
          "git stash show*": "allow",
          "git rev-parse*": "allow",
          "git rev-list*": "allow",
          "git ls-tree*": "allow",
          "git ls-files*": "allow",
          "git describe*": "allow"
        }
      }
    },
    "orchestrator": {
      "description": "Orchestrates work through subagents first, while keeping direct built-in tools available for fallback and verification",
      "mode": "primary",
      "model": "litellm/glm-5.3",
      "prompt": "{file:./agents/orchestrator.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": { "*": "ask" },
        "bash": {
          "*": "ask",
          "cat*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow",
          "git show*": "allow",
          "git stash show*": "allow",
          "git rev-parse*": "allow",
          "git rev-list*": "allow",
          "git ls-tree*": "allow",
          "git ls-files*": "allow",
          "git describe*": "allow",
          "grep*": "allow",
          "ls*": "allow",
          "pwd": "allow",
          "which*": "allow",
          "date": "allow",
          "whoami": "allow",
          "uname*": "allow",
          "bun run*": "allow",
          "php artisan test*": "allow",
          "ruff*": "allow",
          "docker exec -i ff_app*": "allow",
          "systemctl *": "ask",
          "vendor/bin/pint*": "allow",
          "sudo *": "ask"
        },
        "task": "allow",
        "todowrite": "allow",
        "question": "allow",
        "skill": "allow",
        "doom_loop": "allow",
        "stitch_*": "allow",
        "ctx_*": "allow",
        "chrome-devtools_*": "allow",
        "chrome-devtools_lighthouse_audit": "deny",
        "chrome-devtools_performance_analyze_insight": "deny",
        "chrome-devtools_performance_start_trace": "deny",
        "chrome-devtools_performance_stop_trace": "deny",
        "chrome-devtools_take_memory_snapshot": "deny",
        "chrome-devtools_emulate": "deny"
      }
    },
    "writer": {
      "description": "Writes and edits document files (.md, .txt, .rst, .html, .mdx, prose formats) with stop-slop rules enforced. Use for any task that produces a document file.",
      "mode": "subagent",
      "model": "litellm/deepseek-v4-flash",
      "prompt": "{file:./agents/writer.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "write": "allow",
        "external_directory": "allow",
        "doom_loop": "allow",
        "skill": "allow",
        "bash": {
          "*": "deny",
          "cat*": "allow",
          "ls*": "allow"
        }
      }
    },
    "compaction": {
      "mode": "primary",
      "model": "litellm/glm-5.3",
      "permission": {
        "doom_loop": "allow"
      }
    }
  }
}
