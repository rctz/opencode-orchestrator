{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM Gateway",
      "options": {
        "baseURL": "YOUR_URL_HERE",
        "apiKey": "YOUR_API_KEY_HERE"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "copilot-claude-sonnet-5": {
          "name": "claude-sonnet-5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "claude-sonnet-4-6": {
          "name": "claude-sonnet-4-6",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "glm-5.3": {
          "name": "glm-5.3",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "neuralwatt-glm-5.2": {
          "name": "neuralwatt-glm-5.2",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "auto-01": {
          "name": "auto-01"
        }
      }
    },
    "litellm-openai": {
      "npm": "@ai-sdk/openai",
      "name": "LiteLLM OpenAI Responses",
      "options": {
        "baseURL": "YOUR_URL_HERE",
        "apiKey": "YOUR_API_KEY_HERE"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "max",
            "reasoningSummary": "auto",
            "include": [
              "reasoning.encrypted_content"
            ]
          },
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto"
            },
            "max": {
              "reasoningEffort": "max",
              "reasoningSummary": "auto"
            }
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "medium",
            "reasoningSummary": "auto",
            "include": [
              "reasoning.encrypted_content"
            ]
          }
        },
        "copilot-gpt-5.3-codex": {
          "name": "gpt-5.3-codex",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
      }
    },
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Opencode Go",
      "options": {
        "baseURL": "YOUR_URL_HERE",
        "apiKey": "YOUR_API_KEY_HERE"
      }
    }
  },
  "model": "glm-5.3",
  "default_agent": "orchestrator",
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl",
        "http://127.0.0.1:9222"
      ]
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "oauth": false
    },
    "grepika": {
      "type": "local",
      "command": [
        "grepika",
        "--mcp"
      ],
      "enabled": true,
      "timeout": 60000
    },
  },
  "tools": {
    "chrome-devtools_*": true,
    "chrome-devtools_lighthouse_audit": false,
    "chrome-devtools_performance_analyze_insight": false,
    "chrome-devtools_performance_start_trace": false,
    "chrome-devtools_performance_stop_trace": false,
    "chrome-devtools_take_memory_snapshot": false,
    "chrome-devtools_emulate": false
  },
  "formatter": true,
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rmdir *": "ask",
      "unlink *": "ask",
      "shred *": "ask",
      "truncate *": "ask",
      "find * -delete*": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask",
      "git branch -D *": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "git reflog expire*": "ask",
      "git filter-repo*": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "docker system prune*": "ask",
      "docker image prune*": "ask",
      "docker container prune*": "ask",
      "docker volume prune*": "ask",
      "docker volume rm*": "ask",
      "docker rm *": "ask",
      "docker rmi *": "ask",
      "docker compose down *-v*": "ask",
      "docker compose down *--volumes*": "ask",
      "kubectl delete *": "ask",
      "kubectl replace --force*": "ask",
      "helm uninstall *": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "php artisan migrate:fresh*": "ask",
      "php artisan migrate:reset*": "ask",
      "php artisan db:wipe*": "ask",
      "sudo *": "ask",
      "su *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "kill *": "ask",
      "killall *": "ask",
      "pkill *": "ask",
      "systemctl stop *": "ask",
      "systemctl restart *": "ask",
      "systemctl disable *": "ask",
      "systemctl mask *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "fdisk *": "ask",
      "parted *": "ask",
      "shutdown*": "ask",
      "reboot*": "ask",
      "poweroff*": "ask"
    },
    "lsp": "allow",
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "doom_loop": "allow",
    "external_directory": "ask"
  },
  "plugin": [
    "@warp-dot-dev/opencode-warp",
    "@cortexkit/opencode-magic-context@latest",
    "@slkiser/opencode-quota",
    "@dietrichgebert/ponytail"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "agent": {
    "general": {
      "mode": "subagent",
      "model": "litellm-openai/copilot-gpt-5.3-codex",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": {
          "*": "allow",
          "rm *": "ask",
          "rmdir *": "ask",
          "unlink *": "ask",
          "shred *": "ask",
          "truncate *": "ask",
          "find * -delete*": "ask",
          "git reset --hard*": "ask",
          "git clean *": "ask",
          "git checkout -- *": "ask",
          "git restore *": "ask",
          "git branch -D *": "ask",
          "git stash drop*": "ask",
          "git stash clear*": "ask",
          "git reflog expire*": "ask",
          "git filter-repo*": "ask",
          "git push --force*": "ask",
          "git push -f*": "ask",
          "docker system prune*": "ask",
          "docker image prune*": "ask",
          "docker container prune*": "ask",
          "docker volume prune*": "ask",
          "docker volume rm*": "ask",
          "docker rm *": "ask",
          "docker rmi *": "ask",
          "docker compose down *-v*": "ask",
          "docker compose down *--volumes*": "ask",
          "kubectl delete *": "ask",
          "kubectl replace --force*": "ask",
          "helm uninstall *": "ask",
          "terraform apply*": "ask",
          "terraform destroy*": "ask",
          "php artisan migrate:fresh*": "ask",
          "php artisan migrate:reset*": "ask",
          "php artisan db:wipe*": "ask",
          "sudo *": "ask",
          "su *": "ask",
          "chmod *": "ask",
          "chown *": "ask",
          "kill *": "ask",
          "killall *": "ask",
          "pkill *": "ask",
          "systemctl stop *": "ask",
          "systemctl restart *": "ask",
          "systemctl disable *": "ask",
          "systemctl mask *": "ask",
          "dd *": "ask",
          "mkfs*": "ask",
          "fdisk *": "ask",
          "parted *": "ask",
          "shutdown*": "ask",
          "reboot*": "ask",
          "poweroff*": "ask"
        },
        "task": "allow",
        "todowrite": "allow",
        "question": "allow",
        "skill": "allow",
        "doom_loop": "allow",
        "external_directory": "ask"
      }
    },
    "explore": {
      "description": "Read-only local codebase navigation using grepika as primary search engine",
      "mode": "subagent",
      "model": "litellm-openai/gpt-5.6-luna",
      "reasoningEffort": "low",
      "prompt": "{file:./agents/explore.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "external_directory": "allow",
        "doom_loop": "allow",
        "grepika_add_workspace": "allow",
        "grepika_toc": "allow",
        "grepika_search": "allow",
        "grepika_outline": "allow",
        "grepika_get": "allow",
        "grepika_context": "allow",
        "grepika_refs": "allow",
        "grepika_index": "allow",
        "bash": {
          "*": "deny",
          "cat *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "ls *": "allow",
          "pwd": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow",
          "git show*": "allow",
          "git stash show*": "allow",
          "git rev-parse*": "allow",
          "git rev-list*": "allow",
          "git ls-tree*": "allow",
          "git ls-files*": "allow",
          "git describe*": "allow"
        }
      }
    },
    "scout": {
      "description": "Read-only research subagent that prefers DeepWiki, then Context7, then web fallback",
      "mode": "subagent",
      "model": "litellm-openai/gpt-5.6-luna",
      "prompt": "{file:./agents/scout.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "external_directory": "allow",
        "doom_loop": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "context7_*": "allow",
        "deepwiki_*": "allow",
        "bash": {
          "*": "deny",
          "cat *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "ls *": "allow",
          "pwd": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow",
          "git show*": "allow",
          "git stash show*": "allow",
          "git rev-parse*": "allow",
          "git rev-list*": "allow",
          "git ls-tree*": "allow",
          "git ls-files*": "allow",
          "git describe*": "allow"
        }
      }
    },
    "orchestrator": {
      "description": "Orchestrates work through subagents first, while keeping direct built-in tools available for fallback and verification",
      "mode": "primary",
      "model": "litellm-openai/gpt-5.6-sol",
      "reasoningEffort": "max",
      "prompt": "{file:./agents/orchestrator.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": {
          "*": "allow",
          "rm *": "ask",
          "rmdir *": "ask",
          "unlink *": "ask",
          "shred *": "ask",
          "truncate *": "ask",
          "find * -delete*": "ask",
          "git reset --hard*": "ask",
          "git clean *": "ask",
          "git checkout -- *": "ask",
          "git restore *": "ask",
          "git branch -D *": "ask",
          "git stash drop*": "ask",
          "git stash clear*": "ask",
          "git reflog expire*": "ask",
          "git filter-repo*": "ask",
          "git push --force*": "ask",
          "git push -f*": "ask",
          "docker system prune*": "ask",
          "docker image prune*": "ask",
          "docker container prune*": "ask",
          "docker volume prune*": "ask",
          "docker volume rm*": "ask",
          "docker rm *": "ask",
          "docker rmi *": "ask",
          "docker compose down *-v*": "ask",
          "docker compose down *--volumes*": "ask",
          "kubectl delete *": "ask",
          "kubectl replace --force*": "ask",
          "helm uninstall *": "ask",
          "terraform apply*": "ask",
          "terraform destroy*": "ask",
          "php artisan migrate:fresh*": "ask",
          "php artisan migrate:reset*": "ask",
          "php artisan db:wipe*": "ask",
          "sudo *": "ask",
          "su *": "ask",
          "chmod *": "ask",
          "chown *": "ask",
          "kill *": "ask",
          "killall *": "ask",
          "pkill *": "ask",
          "systemctl stop *": "ask",
          "systemctl restart *": "ask",
          "systemctl disable *": "ask",
          "systemctl mask *": "ask",
          "dd *": "ask",
          "mkfs*": "ask",
          "fdisk *": "ask",
          "parted *": "ask",
          "shutdown*": "ask",
          "reboot*": "ask",
          "poweroff*": "ask"
        },
        "task": "allow",
        "todowrite": "allow",
        "question": "allow",
        "skill": "allow",
        "doom_loop": "allow",
        "external_directory": "ask",
        "stitch_*": "allow",
        "ctx_*": "allow",
        "chrome-devtools_*": "allow",
        "chrome-devtools_lighthouse_audit": "deny",
        "chrome-devtools_performance_analyze_insight": "deny",
        "chrome-devtools_performance_start_trace": "deny",
        "chrome-devtools_performance_stop_trace": "deny",
        "chrome-devtools_take_memory_snapshot": "deny",
        "chrome-devtools_emulate": "deny"
      }
    },
    "compaction": {
      "mode": "primary",
      "model": "litellm/deepseek-v4-pro",
      "permission": {
        "doom_loop": "allow"
      }
    },
    "writer": {
      "mode": "subagent",
      "model": "litellm/deepseek-v4-flash",
      "prompt": "{file:./agents/writer.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "write": "allow",
        "task": "allow",
        "skill": "allow",
        "doom_loop": "allow",
        "external_directory": "ask",
        "bash": {
          "*": "deny",
          "cat *": "allow",
          "ls *": "allow",
          "pwd": "allow"
        }
      }
    }
  }
}
